<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="stage0.Probe">
  <insert id="insert">
    INSERT INTO stage0_probe (id, probe_value) VALUES (#{id}, #{value})
  </insert>
  <select id="count" resultType="int">
    SELECT COUNT(*) FROM stage0_probe
  </select>
  <select id="value" resultType="string">
    SELECT probe_value FROM stage0_probe WHERE id = #{id}
  </select>
</mapper>
